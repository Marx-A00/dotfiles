<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.marx.airdrop-inbox</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/.dotfiles/macos/scripts/airdrop-inbox-mover.sh</string>
  </array>
  <!-- Fires on any ~/Downloads change; the script itself filters to
       recent AirDrops (quarantine agent = sharingd) so RunAtLoad and
       spurious triggers are harmless no-ops. -->
  <key>WatchPaths</key>
  <array>
    <string>__HOME__/Downloads</string>
  </array>
  <key>RunAtLoad</key>
  <false/>
  <key>ThrottleInterval</key>
  <integer>1</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/agent-inbox/airdrop-mover.out</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/agent-inbox/airdrop-mover.err</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
